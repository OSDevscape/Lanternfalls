<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/monthly_tbr_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/monthly_tbr_accent_strip"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginBottom="8dp"
        android:background="#A8823C"
        android:text="" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginBottom="8dp">

        <ImageView
            android:id="@+id/monthly_tbr_logo"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/app_name"
            android:scaleType="centerInside"
            android:src="@drawable/lanternfalls_widget_logo" />

        <TextView
            android:id="@+id/monthly_tbr_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginStart="8dp"
            android:layout_marginTop="2dp"
            android:layout_toEndOf="@id/monthly_tbr_logo"
            android:text="MONTHLY TBR"
            android:textColor="#A8823C"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/monthly_tbr_month"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/monthly_tbr_title"
            android:layout_marginStart="8dp"
            android:layout_marginTop="1dp"
            android:layout_toEndOf="@id/monthly_tbr_logo"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="MONTH YEAR"
            android:textColor="#F6F1E4"
            android:textSize="13sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <ListView
        android:id="@+id/monthly_tbr_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="6dp"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/monthly_tbr_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="#C9C1B4"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>