<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/widget_accent_strip"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginBottom="8dp"
        android:background="#A8823C"
        android:text="" />

    <RelativeLayout
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:layout_marginTop="4dp">

    <ImageView
        android:id="@+id/widget_brand_logo"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="8dp"
        android:contentDescription="@string/app_name"
        android:scaleType="centerInside"
        android:src="@drawable/lanternfalls_widget_logo" />

    <TextView
        android:id="@+id/widget_brand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_toEndOf="@id/widget_brand_logo"
        android:layout_marginStart="10dp"
        android:layout_marginTop="13dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="LANTERNFALLS"
        android:textColor="#F6F1E4"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_brand"
        android:layout_toEndOf="@id/widget_brand_logo"
        android:layout_marginStart="10dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Current reading quest"
        android:textColor="#C9C1B4"
        android:textSize="14sp" />

</RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_cover"
            android:layout_width="64dp"
            android:layout_height="92dp"
            android:background="#2B3037"
            android:contentDescription="Current book cover"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_book_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:text="No current book"
                android:textColor="#F6F1E4"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Chronometer
                android:id="@+id/widget_timer"
                android:layout_width="86dp"
                android:layout_height="58dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/widget_timer_idle"
                android:gravity="center"
                android:textColor="#F6F1E4"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_start"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/widget_action_button"
            android:text="Start"
            android:textAllCaps="false"
            android:textColor="#F6F1E4"
            android:textSize="12sp" />

        <Button
            android:id="@+id/widget_pause"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_action_button"
            android:text="Pause"
            android:textAllCaps="false"
            android:textColor="#F6F1E4"
            android:textSize="12sp" />

        <Button
            android:id="@+id/widget_stop"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_stop_button"
            android:text="Stop"
            android:textAllCaps="false"
            android:textColor="#F6F1E4"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>