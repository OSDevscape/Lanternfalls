<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_cover"
            android:layout_width="76dp"
            android:layout_height="112dp"
            android:layout_marginEnd="12dp"
            android:adjustViewBounds="true"
            android:background="#2B3037"
            android:contentDescription="Current book cover"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_book_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="#F6F1E4"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Chronometer
                android:id="@+id/widget_timer"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/widget_timer_idle"
                android:gravity="center"
                android:textColor="#F6F1E4"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_pause"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_action_button"
            android:paddingHorizontal="14dp"
            android:text="Pause"
            android:textAllCaps="false"
            android:textColor="#F6F1E4"
            android:textSize="12sp" />

        <Button
            android:id="@+id/widget_stop"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/widget_stop_button"
            android:paddingHorizontal="14dp"
            android:text="Stop"
            android:textAllCaps="false"
            android:textColor="#F6F1E4"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>